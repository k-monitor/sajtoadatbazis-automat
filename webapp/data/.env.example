# database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=9999
MYSQL_USER=""
MYSQL_PASS=""
MYSQL_DB=""

# turn on for local testing
NO_LOGIN=0

# path for model cache
TRANSFORMERS_CACHE=''

# for paywalls (optional)
COOKIE_444=""
TOKEN_HVG=""
USER_444=""
PASS_444=""
PAYL_444=""
USER_24=""
PASS_24=""
USER_MN=""
PASS_MN=""
USER_PORTFOLIO=""
PASS_PORTFOLIO=""
USER_JELEN=""
PASS_JELEN=""
USER_HANG=""
PASS_HANG=""

# gemini (optional), used by the classification (USE_GEMINI) and the entity descriptions
GEMINI_API_KEY=""
DESCRIPTION_GEMINI_MODEL="gemini-3.5-flash-lite"

# model of the entity descriptions: gemini (default), openai for an OpenAI compatible API, or chatgpt
# for the ChatGPT plan of the account connected on the descriptions page (Sign in with ChatGPT)
DESCRIPTION_PROVIDER=gemini
DESCRIPTION_OPENAI_BASE_URL="https://api.openai.com/v1"
DESCRIPTION_OPENAI_API_KEY=""
DESCRIPTION_OPENAI_MODEL=""
# true if the model can search the web (then it is asked to find more sources)
DESCRIPTION_OPENAI_WEB_SEARCH=false
# JSON merged into the request, e.g. '{"plugins": [{"id": "web"}]}' for the web search of OpenRouter
DESCRIPTION_OPENAI_EXTRA_BODY=""
# empty for the default model of the connected ChatGPT account (the descriptions page lists the others)
DESCRIPTION_CHATGPT_MODEL=""
# false if the plan of the account does not allow web search
DESCRIPTION_CHATGPT_WEB_SEARCH=true
# max. number of KMDB articles in a description prompt
DESCRIPTION_MAX_ARTICLES=10
